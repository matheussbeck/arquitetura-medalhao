# ============================================================================
# VARIÁVEIS DE AMBIENTE - EXEMPLO
# ============================================================================
# IMPORTANTE:
# 1. Copie este arquivo para .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env no git!
# ============================================================================

# Azure Data Lake Storage
AZURE_STORAGE_ACCOUNT=seu-storage-account
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Azure Synapse
SYNAPSE_WORKSPACE_NAME=seu-workspace-synapse
SYNAPSE_SQL_POOL=seu-sql-pool
SYNAPSE_DEDICATED_ENDPOINT=seu-workspace.sql.azuresynapse.net
SYNAPSE_SERVERLESS_ENDPOINT=seu-workspace-ondemand.sql.azuresynapse.net
SYNAPSE_DATABASE=seu-database
SYNAPSE_USERNAME=seu-usuario
SYNAPSE_PASSWORD=sua-senha

# Azure SQL Data Warehouse
AZURE_SQL_SERVER=seu-server.database.windows.net
AZURE_SQL_DATABASE=seu-database
AZURE_SQL_USERNAME=seu-usuario
AZURE_SQL_PASSWORD=sua-senha

# SharePoint Online
SHAREPOINT_SITE_URL=https://suaempresa.sharepoint.com/sites/seu-site
SHAREPOINT_CLIENT_ID=seu-client-id
SHAREPOINT_CLIENT_SECRET=seu-client-secret
SHAREPOINT_TENANT_ID=seu-tenant-id

# Azure Active Directory (para autenticação)
AZURE_TENANT_ID=seu-tenant-id
AZURE_CLIENT_ID=seu-client-id
AZURE_CLIENT_SECRET=seu-client-secret

# Notificações
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
EMAIL_SMTP_SERVER=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=seu-email@empresa.com
EMAIL_PASSWORD=sua-senha

# Configurações de Ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO
